/* ============================== TOKENS ============================== */
:root{
  --ink:#211913;            /* deep espresso - dominant dark */
  --ink-2:#2f231a;
  --cream:#F5F0E8;          /* brand paper */
  --paper:#FBF8F2;          /* raised card */
  --sand:#E4D8C4;           /* hairline borders */
  --gold:#C8A24C;           /* foil accent (the lens gold) */
  --gold-deep:#9A6E24;      /* darker gold for text-on-cream */
  --gold-soft:#E7D3A6;
  --text:#2A211A;           /* body text on cream */
  --muted:#7A6C5D;          /* secondary text */
  --cream-on-ink:#EDE3D4;   /* text on dark */
  --muted-on-ink:#B7A88f;

  --wa:#25D366;             /* whatsapp */

  --serif:"Frank Ruhl Libre", Georgia, serif;
  --sans:"Assistant", system-ui, sans-serif;

  --maxw:1200px;
  --pad:clamp(20px,5vw,40px);
  --radius:16px;

  --shadow-sm:0 2px 10px -4px rgba(33,25,19,.28);
  --shadow-md:0 18px 40px -22px rgba(33,25,19,.5);
  --shadow-gold:0 20px 46px -24px rgba(154,110,36,.55);
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:var(--sans);
  background:var(--cream);
  color:var(--text);
  line-height:1.7;
  font-size:17px;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,h4{font-family:var(--serif);font-weight:700;line-height:1.12;margin:0;letter-spacing:-.01em}
p{margin:0}
a{color:inherit;text-decoration:none}
/* height:auto מנטרל את מאפייני width/height שהפלאגין מוסיף לתמונות
   (הם שם כדי למנוע קפיצת פריסה בטעינה) - בלעדיו התמונות נמתחות */
img{max-width:100%;display:block;height:auto}
:focus-visible{outline:2.5px solid var(--gold-deep);outline-offset:3px;border-radius:4px}

.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--pad)}
.section{padding-block:clamp(64px,9vw,116px)}

/* ---------- shared eyebrow (aperture dot + hairline) ---------- */
.eyebrow{
  display:inline-flex;align-items:center;gap:12px;
  font-family:var(--sans);font-weight:700;font-size:.82rem;
  letter-spacing:.22em;text-transform:none;color:var(--gold-deep);
  margin-bottom:20px;
}
.eyebrow::before{
  content:"";width:26px;height:1.5px;background:linear-gradient(90deg,transparent,var(--gold));
}
.eyebrow.center{justify-content:center}
.eyebrow .dot{width:9px;height:9px;border-radius:50%;border:2px solid var(--gold);position:relative}
.eyebrow .dot::after{content:"";position:absolute;inset:2px;border-radius:50%;background:var(--gold)}

.section-title{font-size:clamp(2rem,4.4vw,3.1rem);color:var(--ink)}
.section-lead{color:var(--muted);max-width:56ch;margin-top:16px;font-size:1.08rem}
.center-head{text-align:center;margin-inline:auto}
.center-head .section-lead{margin-inline:auto}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  font-family:var(--sans);font-weight:700;font-size:1.02rem;
  padding:15px 28px;border-radius:999px;cursor:pointer;border:1.5px solid transparent;
  transition:transform .28s cubic-bezier(.2,.9,.3,1.2),box-shadow .28s ease,background-color .28s ease,color .28s ease;
  will-change:transform;
}
.btn svg{width:20px;height:20px;flex:none}
.btn-wa{background:var(--wa);color:#062b14;box-shadow:0 16px 34px -16px rgba(37,211,102,.7)}
.btn-wa:hover{transform:translateY(-3px);box-shadow:0 22px 40px -14px rgba(37,211,102,.8)}
.btn-wa:active{transform:translateY(-1px)}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:#1a1206;box-shadow:var(--shadow-gold)}
.btn-gold:hover{transform:translateY(-3px)}
.btn-gold:active{transform:translateY(-1px)}
.btn-ghost{background:transparent;border-color:rgba(237,227,212,.45);color:var(--cream-on-ink)}
.btn-ghost:hover{border-color:var(--gold);color:#fff;transform:translateY(-2px)}
.btn-outline{background:transparent;border-color:var(--sand);color:var(--ink)}
.btn-outline:hover{border-color:var(--gold-deep);color:var(--gold-deep);transform:translateY(-2px)}

/* ============================== HEADER ============================== */
.header{
  position:fixed;inset-block-start:0;inset-inline:0;z-index:60;
  transition:background-color .35s ease,box-shadow .35s ease,padding .35s ease;
  padding-block:16px;
}
.header.scrolled{background:rgba(30,22,16,.92);backdrop-filter:blur(12px);box-shadow:0 10px 30px -18px rgba(0,0,0,.7);padding-block:10px}
.header .wrap{display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px;color:#fff}
.brand img{width:46px;height:auto;filter:drop-shadow(0 3px 8px rgba(0,0,0,.4))}
.brand .bt{display:flex;flex-direction:column;line-height:1.05}
.brand .bt b{font-family:var(--serif);font-size:1.18rem;font-weight:700;letter-spacing:.01em}
.brand .bt span{font-size:.72rem;letter-spacing:.16em;color:var(--gold-soft)}
.header.scrolled .brand,.header .brand{color:#fff}
.nav{display:flex;align-items:center;gap:30px}
.nav a{font-weight:600;font-size:.98rem;color:rgba(255,255,255,.9);position:relative;padding-block:4px}
.nav a::after{content:"";position:absolute;inset-inline:0;bottom:-2px;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:right;transition:transform .3s ease}
.nav a:hover::after{transform:scaleX(1)}
.header-cta{display:inline-flex}
.nav-toggle{display:none}

/* ============================== HERO ============================== */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;color:#fff;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:50% 34%}
.hero-bg::after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(to top,rgba(20,14,9,.92) 4%,rgba(20,14,9,.45) 42%,rgba(20,14,9,.55) 100%),
    linear-gradient(to left,rgba(20,14,9,.85),rgba(20,14,9,.15) 62%);
}
.hero .wrap{position:relative;z-index:2;padding-block:140px 90px;width:100%}
.hero-inner{max-width:660px}
.hero h1{font-size:clamp(2.6rem,6.4vw,4.7rem);font-weight:900;color:#fff;line-height:1.05;text-shadow:0 2px 30px rgba(0,0,0,.4)}
.hero h1 em{font-style:normal;color:var(--gold);display:block}
.hero .sub{margin-top:24px;font-size:clamp(1.05rem,2.3vw,1.28rem);color:rgba(255,255,255,.9);max-width:52ch;font-weight:400}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
.hero-trust{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:38px}
.hero-trust li{display:flex;align-items:center;gap:9px;font-size:.96rem;color:rgba(255,255,255,.9);list-style:none;font-weight:500}
.hero-trust svg{width:18px;height:18px;color:var(--gold)}
.hero-trust ul{display:contents}

/* viewfinder focus brackets = signature */
.viewfinder{position:absolute;z-index:2;pointer-events:none}
.vf{position:absolute;width:34px;height:34px;border:2.5px solid rgba(232,211,166,.8)}
.vf.tl{top:0;inset-inline-start:0;border-inline-end:none;border-block-end:none}
.vf.tr{top:0;inset-inline-end:0;border-inline-start:none;border-block-end:none}
.vf.bl{bottom:0;inset-inline-start:0;border-inline-end:none;border-block-start:none}
.vf.br{bottom:0;inset-inline-end:0;border-inline-start:none;border-block-start:none}
.hero-frame{inset:clamp(90px,12vh,130px) clamp(20px,5vw,44px) clamp(30px,7vh,60px)}
.rec{position:absolute;top:clamp(96px,12.6vh,138px);inset-inline-end:clamp(30px,6vw,60px);z-index:3;display:flex;align-items:center;gap:8px;font-size:.78rem;letter-spacing:.18em;color:rgba(255,255,255,.85);font-weight:600}
.rec .blink{width:9px;height:9px;border-radius:50%;background:#e5484d;box-shadow:0 0 0 0 rgba(229,72,77,.6);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(229,72,77,.6)}70%{box-shadow:0 0 0 8px rgba(229,72,77,0)}100%{box-shadow:0 0 0 0 rgba(229,72,77,0)}}

/* ============================== SERVICES ============================== */
.services{background:var(--cream)}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px}
.svc{
  position:relative;border-radius:var(--radius);overflow:hidden;background:var(--ink);
  aspect-ratio:4/5;box-shadow:var(--shadow-md);isolation:isolate;
}
.svc img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.3,1);z-index:0}
.svc::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(20,14,9,.9) 8%,rgba(20,14,9,.15) 55%,rgba(20,14,9,.35))}
.svc:hover img{transform:scale(1.07)}
.svc-body{position:absolute;inset-block-end:0;inset-inline:0;z-index:2;padding:26px 24px}
.svc-body h3{color:#fff;font-size:1.5rem}
.svc-body p{color:rgba(255,255,255,.82);font-size:.96rem;margin-top:8px;max-width:34ch;
  max-height:0;opacity:0;overflow:hidden;transition:max-height .5s ease,opacity .4s ease,margin .4s ease}
.svc:hover .svc-body p,.svc:focus-within .svc-body p{max-height:120px;opacity:1;margin-top:10px}
.svc .num{position:absolute;top:20px;inset-inline-start:20px;z-index:2;font-family:var(--serif);font-size:1rem;color:var(--gold);border:1.5px solid rgba(200,162,76,.5);border-radius:50%;width:40px;height:40px;display:grid;place-items:center;backdrop-filter:blur(3px);background:rgba(20,14,9,.3)}

/* ============================== ABOUT ============================== */
.about{background:var(--paper);position:relative}
.about .wrap{display:grid;grid-template-columns:0.9fr 1.1fr;gap:clamp(30px,5vw,64px);align-items:center}
.about-photo{position:relative}
.about-photo .frame{position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-md)}
.about-photo img{width:100%;aspect-ratio:4/5;object-fit:cover}
.about-photo .viewfinder{inset:14px}
.about-photo .vf{border-color:var(--gold)}
.about-badge{
  position:absolute;inset-block-end:-26px;inset-inline-start:-18px;z-index:3;
  background:var(--ink);color:var(--cream-on-ink);border-radius:14px;padding:16px 22px;
  box-shadow:var(--shadow-md);text-align:center;border:1px solid rgba(200,162,76,.25)
}
.about-badge b{display:block;font-family:var(--serif);color:var(--gold);font-size:1.9rem;line-height:1}
.about-badge span{font-size:.8rem;letter-spacing:.08em;color:var(--muted-on-ink)}
.about h2{font-size:clamp(1.9rem,4vw,2.9rem);color:var(--ink)}
.about .lead{margin-top:18px;color:var(--text);font-size:1.1rem}
.about .body{margin-top:14px;color:var(--muted)}
.why{display:grid;grid-template-columns:1fr 1fr;gap:18px 26px;margin-top:30px}
.why li{list-style:none;display:flex;gap:12px;align-items:flex-start}
.why .ic{flex:none;width:40px;height:40px;border-radius:11px;background:linear-gradient(135deg,var(--gold-soft),transparent);border:1px solid var(--sand);display:grid;place-items:center;color:var(--gold-deep)}
.why .ic svg{width:20px;height:20px}
.why b{display:block;font-weight:700;color:var(--ink);font-size:1.02rem}
.why span{font-size:.92rem;color:var(--muted)}
.about-sign{margin-top:30px;font-family:var(--serif);font-size:1.5rem;color:var(--gold-deep);font-weight:500}

/* ============================== PORTFOLIO ============================== */
.portfolio{background:var(--ink);color:var(--cream-on-ink)}
.portfolio .section-title{color:#fff}
.portfolio .section-lead{color:var(--muted-on-ink)}
.portfolio .eyebrow{color:var(--gold-soft)}
.gallery{columns:3;column-gap:18px;margin-top:48px}
.gallery figure{margin:0 0 18px;position:relative;border-radius:14px;overflow:hidden;break-inside:avoid;box-shadow:0 20px 40px -26px rgba(0,0,0,.9)}
.gallery img{width:100%;transition:transform .7s cubic-bezier(.2,.7,.3,1),filter .5s ease}
.gallery figure::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(20,14,9,.55),transparent 45%);opacity:0;transition:opacity .4s ease}
.gallery figure:hover img{transform:scale(1.06)}
.gallery figure:hover::after{opacity:1}
.gallery figcaption{position:absolute;inset-block-end:12px;inset-inline-start:14px;z-index:2;color:#fff;font-size:.85rem;font-weight:600;letter-spacing:.05em;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}
.gallery figure:hover figcaption{opacity:1;transform:none}

/* ---------- album cards (homepage) ---------- */
.albums{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
.album-card{position:relative;display:block;border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;background:var(--ink-2);box-shadow:0 20px 40px -26px rgba(0,0,0,.9);isolation:isolate}
.album-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.3,1);z-index:0}
.album-card::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(20,14,9,.88) 6%,rgba(20,14,9,.1) 50%,transparent)}
.album-card:hover img,.album-card:focus-visible img{transform:scale(1.06)}
.album-body{position:absolute;inset-block-end:0;inset-inline:0;z-index:2;padding:22px 22px 20px;display:flex;flex-direction:column;gap:4px}
.album-body b{font-family:var(--serif);color:#fff;font-size:1.5rem;font-weight:700;line-height:1.15}
.album-meta{display:inline-flex;align-items:center;gap:6px;color:var(--gold-soft);font-size:.92rem;font-weight:600}
.album-meta svg{width:16px;height:16px;transition:transform .3s ease}
.album-card:hover .album-meta svg{transform:translateX(-4px)}

/* ============================== ALBUM PAGE ============================== */
.album-page{background:var(--cream)}
.album-page .header{background:rgba(30,22,16,.94);backdrop-filter:blur(12px);padding-block:10px}
.back-link{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:rgba(255,255,255,.9);font-weight:600;font-size:.98rem}
.back-link svg{width:18px;height:18px}
.back-link:hover{color:var(--gold-soft)}
.album-head{padding-block:clamp(110px,14vw,150px) 10px;text-align:center}
.album-head h1{font-size:clamp(2.3rem,5.4vw,3.8rem);color:var(--ink)}
.album-head .section-lead{margin-inline:auto}
.album-count{display:inline-block;margin-top:14px;color:var(--gold-deep);font-weight:700;font-size:.95rem;letter-spacing:.06em}
.album-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:26px}
.album-nav a{padding:8px 16px;border-radius:999px;border:1.5px solid var(--sand);background:var(--paper);color:var(--text);font-weight:600;font-size:.92rem;transition:border-color .25s ease,color .25s ease,background-color .25s ease}
.album-nav a:hover{border-color:var(--gold);color:var(--gold-deep)}
.album-nav a[aria-current="page"]{background:var(--ink);border-color:var(--ink);color:var(--gold-soft)}
.album-page .gallery{margin-top:34px}
.album-page .gallery figure{box-shadow:var(--shadow-md)}
.gallery .open{display:block;width:100%;padding:0;border:0;background:none;cursor:zoom-in}
.album-page .gallery figure::after{display:none}
.album-cta{text-align:center;padding-block:clamp(40px,7vw,80px) clamp(70px,9vw,110px)}
.album-cta h2{font-size:clamp(1.7rem,3.6vw,2.4rem);color:var(--ink)}
.album-cta p{color:var(--muted);margin:12px auto 26px;max-width:46ch}
.album-cta .row{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}

/* ---------- lightbox ---------- */
.lb{position:fixed;inset:0;z-index:100;background:rgba(16,11,7,.96);display:none;align-items:center;justify-content:center}
.lb.open{display:flex}
.lb img{max-width:92vw;max-height:86vh;width:auto;height:auto;object-fit:contain;border-radius:6px;box-shadow:0 30px 60px -20px rgba(0,0,0,.8);user-select:none}
.lb button{position:absolute;display:grid;place-items:center;width:52px;height:52px;border-radius:50%;border:1px solid rgba(231,211,166,.35);background:rgba(33,25,19,.6);color:#fff;cursor:pointer;transition:background-color .2s ease,border-color .2s ease}
.lb button:hover{background:rgba(200,162,76,.35);border-color:var(--gold)}
.lb button svg{width:24px;height:24px}
.lb .lb-close{top:18px;inset-inline-end:18px}
.lb .lb-prev{inset-inline-start:18px;top:50%;transform:translateY(-50%)}
.lb .lb-next{inset-inline-end:18px;top:50%;transform:translateY(-50%)}
.lb .lb-count{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);color:var(--muted-on-ink);font-size:.9rem;letter-spacing:.12em}

/* ============================== PROCESS ============================== */
.process{background:var(--cream)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:52px}
.step{position:relative;padding:30px 24px;background:var(--paper);border:1px solid var(--sand);border-radius:var(--radius);transition:transform .3s ease,box-shadow .3s ease}
.step:hover{transform:translateY(-5px);box-shadow:var(--shadow-md)}
.step .n{font-family:var(--serif);font-size:2.7rem;color:var(--gold);line-height:1;font-weight:700;opacity:.5}
.step h3{margin-top:10px;font-size:1.28rem;color:var(--ink)}
.step p{margin-top:8px;color:var(--muted);font-size:.96rem}
.step::before{content:"";position:absolute;inset-block-start:36px;inset-inline-start:-13px;width:22px;height:2px;background:var(--sand)}
.step:first-child::before{display:none}

/* ============================== TESTIMONIALS ============================== */
.testi{background:var(--paper)}
.t-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px}
.t-card{background:var(--cream);border:1px solid var(--sand);border-radius:var(--radius);padding:30px 28px;position:relative;box-shadow:var(--shadow-sm)}
.t-card .q{font-family:var(--serif);font-size:3.4rem;color:var(--gold-soft);line-height:.6;height:24px}
.stars{color:var(--gold);letter-spacing:2px;font-size:1rem;margin-block:6px 12px}
.t-card p{color:var(--text);font-size:1.02rem}
.t-card .who{margin-top:18px;display:flex;align-items:center;gap:12px}
.t-card .av{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-deep));color:#fff;display:grid;place-items:center;font-family:var(--serif);font-weight:700;font-size:1.1rem}
.t-card .who b{display:block;color:var(--ink);font-size:.98rem}
.t-card .who span{font-size:.85rem;color:var(--muted)}

/* ============================== ASSURANCE BAND ============================== */
.band{background:linear-gradient(135deg,var(--ink),var(--ink-2));color:#fff;position:relative;overflow:hidden}
.band::before{content:"";position:absolute;inset-block-start:-40%;inset-inline-start:-10%;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(200,162,76,.16),transparent 68%)}
.band .wrap{position:relative;display:flex;align-items:center;justify-content:space-between;gap:34px;flex-wrap:wrap}
.band h2{font-size:clamp(1.7rem,3.6vw,2.5rem);color:#fff;max-width:20ch}
.band h2 em{color:var(--gold);font-style:normal}
.band p{color:var(--muted-on-ink);margin-top:12px;max-width:44ch}
.band-cta{display:flex;gap:14px;flex-wrap:wrap}

/* ============================== CONTACT ============================== */
.contact{background:var(--cream)}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,60px);align-items:start}
.contact-info .eyebrow{margin-bottom:16px}
.ci-list{margin-top:30px;display:flex;flex-direction:column;gap:6px}
.ci{display:flex;gap:16px;align-items:center;padding:16px;border-radius:14px;transition:background-color .3s ease}
.ci:hover{background:var(--paper)}
.ci .ic{flex:none;width:52px;height:52px;border-radius:14px;background:var(--ink);color:var(--gold);display:grid;place-items:center}
.ci .ic svg{width:24px;height:24px}
.ci b{display:block;color:var(--ink);font-size:1.12rem}
.ci span{color:var(--muted);font-size:.92rem}
.ci a{color:var(--ink)}

.form-card{background:var(--paper);border:1px solid var(--sand);border-radius:20px;padding:clamp(24px,4vw,38px);box-shadow:var(--shadow-md)}
.form-card h3{font-size:1.6rem;color:var(--ink)}
.form-card .fnote{color:var(--muted);font-size:.95rem;margin-top:6px;margin-bottom:22px}
.field{margin-bottom:16px}
.field label{display:block;font-weight:600;font-size:.92rem;color:var(--ink);margin-bottom:7px}
.field input,.field select,.field textarea{
  width:100%;font-family:var(--sans);font-size:1rem;color:var(--text);
  padding:13px 16px;border:1.5px solid var(--sand);border-radius:12px;background:#fff;
  transition:border-color .25s ease,box-shadow .25s ease;
}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 4px rgba(200,162,76,.16)}
.field textarea{resize:vertical;min-height:88px}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-card .btn-wa{width:100%;margin-top:6px}
.form-privacy{text-align:center;font-size:.82rem;color:var(--muted);margin-top:14px}

/* ============================== FOOTER ============================== */
.footer{background:var(--ink-2);color:var(--muted-on-ink);padding-block:56px 30px}
.footer .top{display:flex;justify-content:space-between;gap:34px;flex-wrap:wrap;padding-bottom:34px;border-bottom:1px solid rgba(200,162,76,.16)}
.footer .brand img{width:56px}
.footer .brand .bt b{color:#fff}
.f-links{display:flex;gap:60px;flex-wrap:wrap}
.f-col h4{color:var(--gold-soft);font-family:var(--sans);font-size:.82rem;letter-spacing:.16em;font-weight:700;margin-bottom:14px}
.f-col a,.f-col p{display:block;color:var(--muted-on-ink);font-size:.95rem;margin-bottom:9px;transition:color .25s ease}
.f-col a:hover{color:var(--gold)}
.footer .copy{margin-top:26px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.85rem;color:var(--muted-on-ink)}
.footer .copy a{color:var(--gold-soft)}

/* ============================== MOBILE CTA BAR ============================== */
.mobile-cta{
  position:fixed;inset-block-end:0;inset-inline:0;z-index:70;display:none;
  grid-template-columns:1fr 1fr;gap:1px;background:rgba(200,162,76,.3);
  box-shadow:0 -8px 24px -12px rgba(0,0,0,.4);
}
.mobile-cta a{display:flex;align-items:center;justify-content:center;gap:8px;padding:15px;font-weight:700;font-size:1rem}
.mobile-cta .m-wa{background:var(--wa);color:#062b14}
.mobile-cta .m-call{background:var(--ink);color:var(--gold-soft)}
.mobile-cta svg{width:20px;height:20px}

/* ============================== REVEAL ANIM ============================== */
.js .reveal{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.3,1)}
.js .reveal.in{opacity:1;transform:none}

/* ============================== RESPONSIVE ============================== */
@media (max-width:960px){
  .nav,.header-cta{display:none}
  .svc-grid,.t-grid{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:1fr 1fr}
  .gallery{columns:2}
  .albums{grid-template-columns:1fr 1fr;gap:16px}
  .about .wrap,.contact .wrap{grid-template-columns:1fr}
  .about-photo{max-width:420px;margin-inline:auto}
  .svc-body p{max-height:120px;opacity:1;margin-top:10px}
  .step::before{display:none}
}
@media (max-width:620px){
  body{font-size:16px}
  .svc-grid,.t-grid,.steps{grid-template-columns:1fr}
  .gallery{columns:2;column-gap:10px}
  .gallery figure{margin-bottom:10px;border-radius:10px}
  .albums{gap:12px}
  .album-body{padding:14px 14px 13px}
  .album-body b{font-size:1.15rem}
  .album-meta{font-size:.8rem}
  .lb .lb-prev,.lb .lb-next{top:auto;bottom:14px;transform:none;width:46px;height:46px}
  .album-page .brand .bt span{display:none}
  .back-link{font-size:.9rem}
  .why,.field-row{grid-template-columns:1fr}
  .mobile-cta{display:grid}
  .hero .wrap{padding-block:120px 110px}
  .footer .copy{flex-direction:column}
  .hero-frame,.rec{display:none}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
  .reveal{opacity:1;transform:none}
}
