<!-- ============ ACCESSIBILITY MENU ============ -->
<div class="a11y" id="a11y">
  <button class="a11y-btn" id="a11yBtn" type="button" aria-expanded="false" aria-controls="a11yPanel" aria-label="תפריט נגישות" title="נגישות">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="4.2" r="2.2"/><path d="M20.5 7.6c-.2-.7-.9-1.1-1.6-.9-2.2.6-4.5.9-6.9.9s-4.7-.3-6.9-.9c-.7-.2-1.4.2-1.6.9-.2.7.2 1.4.9 1.6 1.8.5 3.7.8 5.6.9v3.1l-2.1 7.1c-.2.7.2 1.5.9 1.7.7.2 1.5-.2 1.7-.9L12 15.6l1.5 5.5c.2.7 1 1.1 1.7.9.7-.2 1.1-1 .9-1.7l-2.1-7.1v-3.1c1.9-.1 3.8-.4 5.6-.9.7-.2 1.1-.9.9-1.6z"/></svg>
  </button>
  <div class="a11y-panel" id="a11yPanel" role="dialog" aria-modal="false" aria-labelledby="a11yTitle" hidden>
    <div class="a11y-head">
      <b id="a11yTitle">נגישות</b>
      <button class="a11y-x" type="button" data-a11y-close aria-label="סגירת תפריט הנגישות">&times;</button>
    </div>
    <div class="a11y-grid">
      <button type="button" data-a11y="font-up">הגדלת טקסט <span aria-hidden="true" dir="ltr">A+</span></button>
      <button type="button" data-a11y="font-down">הקטנת טקסט <span aria-hidden="true" dir="ltr">A−</span></button>
      <button type="button" data-a11y="contrast" aria-pressed="false">ניגודיות גבוהה</button>
      <button type="button" data-a11y="gray" aria-pressed="false">גווני אפור</button>
      <button type="button" data-a11y="links" aria-pressed="false">הדגשת קישורים</button>
      <button type="button" data-a11y="font" aria-pressed="false">גופן קריא</button>
      <button type="button" data-a11y="motion" aria-pressed="false">עצירת אנימציות</button>
      <button type="button" data-a11y="reset">איפוס</button>
    </div>
    <a class="a11y-link" href="/accessibility/">הצהרת נגישות</a>
  </div>
</div>
<script>
(function(){
  var root = document.documentElement, KEY = 'a11y-prefs';
  var btn = document.getElementById('a11yBtn'), panel = document.getElementById('a11yPanel');
  var toggles = ['contrast','gray','links','font','motion'];
  var prefs = {size:0};
  try { prefs = JSON.parse(localStorage.getItem(KEY)) || prefs; } catch(e) {}
  function apply(){
    root.style.fontSize = prefs.size ? (100 + prefs.size * 12.5) + '%' : '';
    toggles.forEach(function(t){
      root.classList.toggle('a11y-' + t, !!prefs[t]);
      var b = panel.querySelector('[data-a11y="' + t + '"]'); if(b) b.setAttribute('aria-pressed', prefs[t] ? 'true' : 'false');
    });
    try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch(e) {}
  }
  function open(){ panel.hidden = false; btn.setAttribute('aria-expanded','true'); panel.querySelector('button').focus(); }
  function close(){ panel.hidden = true; btn.setAttribute('aria-expanded','false'); btn.focus(); }
  btn.addEventListener('click', function(){ panel.hidden ? open() : close(); });
  panel.addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    if(b.hasAttribute('data-a11y-close')) return close();
    var a = b.getAttribute('data-a11y');
    if(a === 'font-up') prefs.size = Math.min(4, (prefs.size||0) + 1);
    else if(a === 'font-down') prefs.size = Math.max(0, (prefs.size||0) - 1);
    else if(a === 'reset') prefs = {size:0};
    else if(toggles.indexOf(a) > -1) prefs[a] = !prefs[a];
    apply();
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !panel.hidden) close(); });
  document.addEventListener('click', function(e){ if(!panel.hidden && !e.target.closest('#a11y')) { panel.hidden = true; btn.setAttribute('aria-expanded','false'); } });
  apply();
})();
</script>
