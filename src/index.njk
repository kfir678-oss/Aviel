---
permalink: /index.html
---
{%- from "macros.njk" import waIcon, phoneIcon -%}
{%- macro pointIcon(name) -%}
{%- if name == "eye" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3.2"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/></svg>
{%- elif name == "clock" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg>
{%- elif name == "hands" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21l8.84-8.61a5.5 5.5 0 0 0 0-7.78z" stroke-linejoin="round"/></svg>
{%- elif name == "camera" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8.5h3l1.5-2.5h9L18 8.5h3v10H3z" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.4"/></svg>
{%- elif name == "star" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.4l6.1-.8z" stroke-linejoin="round"/></svg>
{%- else -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.35-9.5-8.5C.5 9 2 5 5.5 5 8 5 12 8 12 8s4-3 6.5-3C22 5 23.5 9 21.5 12.5 19 16.65 12 21 12 21z" stroke-linejoin="round"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- set waBase = "https://wa.me/" + settings.whatsapp_number -%}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- ============ SEO ============ -->
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.description }}" />
<meta name="keywords" content="{{ seo.keywords }}" />
<meta name="author" content="{{ settings.photographer }}" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#211913" />
<link rel="canonical" href="{{ settings.site_url }}" />
<link rel="icon" type="image/png" href="{{ settings.favicon }}" />
<link rel="apple-touch-icon" href="{{ settings.favicon }}" />

<!-- ============ Open Graph / Social ============ -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="he_IL" />
<meta property="og:site_name" content="{{ settings.brand_name }} - {{ settings.photographer }}" />
<meta property="og:title" content="{{ seo.og_title }}" />
<meta property="og:description" content="{{ seo.og_description }}" />
<meta property="og:image" content="{{ seo.og_image }}" />
<meta property="og:url" content="{{ settings.site_url }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ seo.og_title }}" />
<meta name="twitter:description" content="{{ seo.og_description }}" />
<meta name="twitter:image" content="{{ seo.og_image }}" />

<!-- ============ Fonts ============ -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

<!-- ============ Structured Data: LocalBusiness / Photographer ============ -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Photograph",
  "@id": "{{ settings.site_url }}#business",
  "name": "{{ settings.brand_name }} - {{ settings.photographer }}",
  "image": "{{ settings.site_url }}{{ seo.og_image | replace("/", "", 1) }}",
  "description": {{ seo.description | dump | safe }},
  "telephone": "{{ settings.phone_intl }}",
  "priceRange": "₪₪",
  "areaServed": { "@type": "Country", "name": "ישראל" },
  "founder": { "@type": "Person", "name": "{{ settings.photographer }}" },
  "knowsAbout": [{% for k in seo.knows_about %}{{ k.term | dump | safe }}{{ "," if not loop.last }}{% endfor %}],
  "sameAs": [{% for l in seo.social_links %}{{ l.url | dump | safe }}{{ "," if not loop.last }}{% endfor %}]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "צילום אירועים ואירועים משפחתיים",
  "provider": { "@type": "Person", "name": "{{ settings.photographer }}", "telephone": "{{ settings.phone_intl }}" },
  "areaServed": "ישראל",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "שירותי צילום",
    "itemListElement": [
      {%- for k in seo.knows_about %}
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ k.term | dump | safe }} } }{{ "," if not loop.last }}
      {%- endfor %}
    ]
  }
}
</script>

<style>
{% include "styles.njk" %}
</style>
</head>
<body>

<!-- ============ HEADER ============ -->
<header class="header" id="header">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="{{ settings.brand_name }} - {{ settings.photographer }}, לדף הבית">
      <img src="{{ settings.logo }}" alt="לוגו {{ settings.brand_name }}" eleventy:ignore />
      <span class="bt"><b>{{ settings.brand_name }}</b><span>{{ settings.brand_tagline }}</span></span>
    </a>
    <nav class="nav" aria-label="ניווט ראשי">
      <a href="#services">שירותים</a>
      <a href="#about">עליי</a>
      <a href="#portfolio">תיק עבודות</a>
      <a href="#process">איך זה עובד</a>
      <a href="#contact">צור קשר</a>
    </nav>
    <a class="btn btn-wa header-cta" href="{{ waBase }}?text={{ hero.cta_message | urlencode }}" target="_blank" rel="noopener" aria-label="שליחת הודעה בוואטסאפ">
      {{ waIcon() }}
      וואטסאפ
    </a>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-bg">
    <img src="{{ hero.image }}" alt="{{ hero.image_alt }}" sizes="100vw" fetchpriority="high" />
  </div>
  <div class="viewfinder hero-frame" aria-hidden="true">
    <span class="vf tl"></span><span class="vf tr"></span><span class="vf bl"></span><span class="vf br"></span>
  </div>
  <div class="rec" aria-hidden="true"><span class="blink"></span>REC · {{ settings.brand_name }}</div>
  <div class="wrap">
    <div class="hero-inner">
      <span class="eyebrow" style="color:var(--gold-soft)"><span class="dot"></span>{{ hero.eyebrow }}</span>
      <h1>{{ hero.title }} <em>{{ hero.title_accent }}</em></h1>
      <p class="sub">{{ hero.sub }}</p>
      <div class="hero-cta">
        <a class="btn btn-wa" href="{{ waBase }}?text={{ hero.cta_message | urlencode }}" target="_blank" rel="noopener">
          {{ waIcon() }}
          {{ hero.cta_label }}
        </a>
        <a class="btn btn-ghost" href="tel:{{ settings.phone_intl }}">
          {{ phoneIcon() }}
          {{ settings.phone_display }}
        </a>
      </div>
      <ul class="hero-trust">
        {%- for t in hero.trust %}
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ t.text }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section services" id="services">
  <div class="wrap">
    <div class="center-head reveal" style="max-width:640px">
      <span class="eyebrow center"><span class="dot"></span>{{ services.eyebrow }}</span>
      <h2 class="section-title">{{ services.title }}</h2>
      <p class="section-lead">{{ services.lead }}</p>
    </div>
    <div class="svc-grid">
      {%- for s in services.items %}
      <article class="svc reveal">
        <img src="{{ s.image }}" alt="{{ s.image_alt }}" sizes="(max-width:620px) 100vw, (max-width:960px) 50vw, 33vw" loading="lazy" />
        <span class="num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
        <div class="svc-body"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section about" id="about">
  <div class="wrap">
    <div class="about-photo reveal">
      <div class="frame">
        <img src="{{ about.image }}" alt="{{ about.image_alt }}" sizes="(max-width:960px) 420px, 40vw" loading="lazy" />
        <div class="viewfinder" aria-hidden="true"><span class="vf tl"></span><span class="vf tr"></span><span class="vf bl"></span><span class="vf br"></span></div>
      </div>
      <div class="about-badge"><b>{{ about.badge_title }}</b><span>{{ about.badge_text }}</span></div>
    </div>
    <div class="about-text reveal">
      <span class="eyebrow"><span class="dot"></span>{{ about.eyebrow }}</span>
      <h2>{{ about.title }}</h2>
      <p class="lead">{{ about.lead }}</p>
      <p class="body">{{ about.body }}</p>
      <ul class="why">
        {%- for p in about.points %}
        <li><span class="ic">{{ pointIcon(p.icon) }}</span><div><b>{{ p.title }}</b><span>{{ p.text }}</span></div></li>
        {%- endfor %}
      </ul>
      <p class="about-sign">{{ about.signature }}</p>
    </div>
  </div>
</section>

<!-- ============ PORTFOLIO ============ -->
<section class="section portfolio" id="portfolio">
  <div class="wrap">
    <div class="center-head reveal" style="max-width:640px">
      <span class="eyebrow center"><span class="dot"></span>{{ portfolio.eyebrow }}</span>
      <h2 class="section-title">{{ portfolio.title }}</h2>
      <p class="section-lead">{{ portfolio.lead }}</p>
    </div>
    <div class="albums">
      {%- for al in portfolio.albums %}{% if al.images and al.images.length %}
      <a class="album-card reveal" href="/gallery/{{ al.slug }}/" aria-label="גלריית {{ al.title }} - {{ al.images.length }} תמונות">
        <img src="{{ al.cover or al.images[0] }}" alt="{{ al.title }} - צילום של {{ settings.photographer }}" sizes="(max-width:620px) 50vw, (max-width:960px) 50vw, 33vw" loading="lazy">
        <span class="album-body">
          <b>{{ al.title }}</b>
          <span class="album-meta">{{ al.images.length }} תמונות <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </span>
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="section process" id="process">
  <div class="wrap">
    <div class="center-head reveal" style="max-width:640px">
      <span class="eyebrow center"><span class="dot"></span>{{ process.eyebrow }}</span>
      <h2 class="section-title">{{ process.title }}</h2>
      <p class="section-lead">{{ process.lead }}</p>
    </div>
    <div class="steps">
      {%- for st in process.steps %}
      <div class="step reveal"><div class="n">{{ loop.index }}</div><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section testi" id="testimonials">
  <div class="wrap">
    <div class="center-head reveal" style="max-width:640px">
      <span class="eyebrow center"><span class="dot"></span>{{ testimonials.eyebrow }}</span>
      <h2 class="section-title">{{ testimonials.title }}</h2>
      <p class="section-lead">{{ testimonials.lead }}</p>
    </div>
    <div class="t-grid">
      {%- for t in testimonials.items %}
      <div class="t-card reveal">
        <div class="q">&rdquo;</div><div class="stars">{% for i in range(t.stars or 5) %}★{% endfor %}</div>
        <p>{{ t.quote }}</p>
        <div class="who"><span class="av">{{ t.initial if t.initial else t.name[0] }}</span><div><b>{{ t.name }}</b><span>{{ t.event }}</span></div></div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ============ ASSURANCE BAND ============ -->
<section class="band">
  <div class="wrap">
    <div class="reveal">
      <h2>{{ band.title }} <em>{{ band.title_accent }}</em> {{ band.title_end }}</h2>
      <p>{{ band.text }}</p>
    </div>
    <div class="band-cta reveal">
      <a class="btn btn-gold" href="#contact">{{ band.cta_primary }}</a>
      <a class="btn btn-ghost" href="{{ waBase }}?text={{ band.cta_secondary_message | urlencode }}" target="_blank" rel="noopener">{{ band.cta_secondary }}</a>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="section contact" id="contact">
  <div class="wrap">
    <div class="contact-info reveal">
      <span class="eyebrow"><span class="dot"></span>{{ contact.eyebrow }}</span>
      <h2 class="section-title">{{ contact.title }}</h2>
      <p class="section-lead">{{ contact.lead }}</p>
      <div class="ci-list">
        <a class="ci" href="{{ waBase }}" target="_blank" rel="noopener">
          <span class="ic">{{ waIcon() }}</span>
          <div><b>וואטסאפ</b><span>{{ contact.whatsapp_note }}</span></div>
        </a>
        <a class="ci" href="tel:{{ settings.phone_intl }}">
          <span class="ic">{{ phoneIcon() }}</span>
          <div><b>טלפון</b><span dir="ltr">{{ settings.phone_display }}</span></div>
        </a>
        <div class="ci">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke-linejoin="round"/><circle cx="12" cy="10" r="3"/></svg></span>
          <div><b>אזור פעילות</b><span>{{ settings.area }}</span></div>
        </div>
      </div>
    </div>

    <div class="form-card reveal">
      <h3>{{ contact.form_title }}</h3>
      <p class="fnote">{{ contact.form_note }}</p>
      <form id="leadForm" novalidate>
        <div class="field">
          <label for="fname">שם מלא</label>
          <input id="fname" name="fname" type="text" autocomplete="name" placeholder="איך לפנות אליכם?" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="fphone">טלפון</label>
            <input id="fphone" name="fphone" type="tel" inputmode="tel" autocomplete="tel" placeholder="050-0000000" required />
          </div>
          <div class="field">
            <label for="ftype">סוג האירוע</label>
            <select id="ftype" name="ftype" required>
              <option value="" selected disabled>בחרו אירוע</option>
              {%- for e in contact.event_types %}
              <option>{{ e.label }}</option>
              {%- endfor %}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="fdate">תאריך משוער (אם ידוע)</label>
          <input id="fdate" name="fdate" type="date" />
        </div>
        <div class="field">
          <label for="fmsg">משהו שחשוב שאדע?</label>
          <textarea id="fmsg" name="fmsg" placeholder="מקום האירוע, שעה, בקשות מיוחדות..."></textarea>
        </div>
        <button class="btn btn-wa" type="submit">
          {{ waIcon() }}
          שליחה בוואטסאפ
        </button>
        <p class="form-privacy">{{ contact.form_privacy }}</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <a class="brand" href="#top">
        <img src="{{ settings.logo }}" alt="לוגו {{ settings.brand_name }}" eleventy:ignore />
        <span class="bt"><b>{{ settings.brand_name }}</b><span>{{ settings.brand_tagline }}</span></span>
      </a>
      <div class="f-links">
        <div class="f-col">
          <h4>שירותים</h4>
          {%- for s in services.items %}{% if loop.index <= 5 %}
          <a href="#services">{{ s.title }}</a>
          {%- endif %}{% endfor %}
        </div>
        <div class="f-col">
          <h4>ניווט</h4>
          <a href="#about">עליי</a>
          <a href="#portfolio">תיק עבודות</a>
          <a href="#process">איך זה עובד</a>
          <a href="#contact">צור קשר</a>
        </div>
        <div class="f-col">
          <h4>יצירת קשר</h4>
          <a href="tel:{{ settings.phone_intl }}" dir="ltr">{{ settings.phone_display }}</a>
          <a href="{{ waBase }}" target="_blank" rel="noopener">וואטסאפ</a>
          <p>אזור פעילות: {{ settings.area }}</p>
        </div>
      </div>
    </div>
    <div class="copy">
      <span>© <span id="year">2025</span> {{ settings.brand_name }} · {{ settings.photographer }} · כל הזכויות שמורות</span>
      <span>עוצב ונבנה באהבה לרגעים שלא חוזרים</span>
    </div>
  </div>
</footer>

<!-- ============ MOBILE CTA ============ -->
<div class="mobile-cta">
  <a class="m-call" href="tel:{{ settings.phone_intl }}">
    {{ phoneIcon() }}
    התקשרו
  </a>
  <a class="m-wa" href="{{ waBase }}?text={{ hero.cta_message | urlencode }}" target="_blank" rel="noopener">
    {{ waIcon() }}
    וואטסאפ
  </a>
</div>

<script>
// enable reveal animations only when JS is available (content stays visible otherwise)
document.documentElement.classList.add('js');

// year
document.getElementById('year').textContent = new Date().getFullYear();

// header scroll state
const header = document.getElementById('header');
const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
onScroll(); window.addEventListener('scroll', onScroll, {passive:true});

// reveal on scroll
const io = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
},{threshold:0.12, rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.reveal').forEach((el,i)=>{
  el.style.transitionDelay = (Math.min(i%6,5)*60)+'ms';
  io.observe(el);
});

// lead form -> whatsapp deep link
document.getElementById('leadForm').addEventListener('submit', function(ev){
  ev.preventDefault();
  const v = id => (document.getElementById(id).value || '').trim();
  const name = v('fname'), phone = v('fphone'), type = v('ftype'), date = v('fdate'), msg = v('fmsg');
  if(!name || !phone || !type){
    alert('נא למלא שם, טלפון וסוג אירוע');
    return;
  }
  let t = 'היי אביאל! 👋\n';
  t += 'שמי ' + name + '.\n';
  t += 'מעוניין/ת בצילום: ' + type + '.\n';
  if(date) t += 'תאריך משוער: ' + date + '.\n';
  t += 'טלפון לחזרה: ' + phone + '.\n';
  if(msg) t += 'פרטים: ' + msg + '\n';
  t += 'אשמח לפרטים ולמחיר. תודה!';
  window.open('{{ waBase }}?text=' + encodeURIComponent(t), '_blank');
});
</script>
</body>
</html>
